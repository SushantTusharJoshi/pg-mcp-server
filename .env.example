# Superuser password for the local Docker Postgres (used only by docker compose).
# Required: pick any strong value.
POSTGRES_PASSWORD=

# Connection used by the MCP server (read-only role created by seed/init.sql)
PG_HOST=localhost
PG_PORT=5432
PG_USER=mcp_readonly
PG_PASSWORD=mcp_readonly
PG_DATABASE=bookstore

# Query limits
QUERY_ROW_LIMIT=100
STATEMENT_TIMEOUT_MS=5000
