# Superuser password for the local Docker Postgres (used only by docker compose).
# Required: pick any strong value.
POSTGRES_PASSWORD=

# Connection used by the MCP server (read-only role created by seed/init.sql)
PG_HOST=localhost
PG_PORT=5432
PG_USER=mcp_readonly
PG_PASSWORD=mcp_readonly
PG_DATABASE=bookstore
# Optional TLS to Postgres: disable, allow, prefer, require, verify-ca, verify-full
# (verify-* also read PGSSLROOTCERT). Standard PGHOST, PGPORT, ... work as fallbacks.
# PG_SSLMODE=

# Bookstore demo tool (search_books). On by default; set 0 for any other database,
# which leaves only the generic inspect_schema and query (see README, "Generic mode").
# PG_MCP_BOOKSTORE_TOOLS=1

# Query limits
QUERY_ROW_LIMIT=100
STATEMENT_TIMEOUT_MS=5000
QUERY_MAX_BYTES=200000

# Audit log (one JSON line per tool call, see docs/audit-log.md)
# PG_MCP_AUDIT_LOG=./pg-mcp-audit.jsonl

# Transport: stdio (default) or http (streamable HTTP with bearer tokens)
# PG_MCP_TRANSPORT=stdio
# PG_MCP_HTTP_HOST=127.0.0.1
# PG_MCP_HTTP_PORT=8000
# Comma-separated Host header values to accept when binding to something other than loopback
# PG_MCP_ALLOWED_HOSTS=
# Token hashes, never the tokens themselves (see README, "HTTP mode")
# PG_MCP_TOKENS={"analyst": {"sha256": "<64 hex>", "tools": ["query", "inspect_schema", "search_books"]}}
